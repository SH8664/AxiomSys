@page

@{
     ViewData["Title"] = "Delivery Terms Management";
}
@section Styles {
    <link rel="stylesheet" href="~/css/SALES/DELIVERYTERMS.css" asp-append-version="true" />
}


@model IndexModel

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@SharedLocalizer["12"]</h2>
        <button class="btn btn-primary" onclick="openAddModal()">+ @SharedLocalizer["32"]</button>
    </div>

    <!-- DataTables Card -->
    <div class="card shadow-sm">
        <div class="card-body">
            <table id="termsTable" class="table table-striped table-hover w-100">
                <thead>
                    <tr>
                        <th>@SharedLocalizer["3"]</th>
                        <th>@SharedLocalizer["5"]</th>
                        <th>@SharedLocalizer["4"]</th>
                        <th>@SharedLocalizer["6"]</th>
                        <th>@SharedLocalizer["7"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var term in Model.SaDeliveryTermModels)
                    {
                        <tr>
                            <td>@term.Code</td>
                            <td>@term.SName</td>
                            <td>@term.BName</td>
                            <td>@term.Days</td>
                            <td>@(term.Active ? @SharedLocalizer["8"]  : @SharedLocalizer["9"]) </td>
                            <td class="text-end">  
                                <button class="btn btn-sm btn-warning me-1" onclick="openEditModal(@term.Code)">@SharedLocalizer["5583"]</button>
                                <button class="btn btn-sm btn-danger" onclick="deleteTerm(@term.Code)">@SharedLocalizer["18"]</button>
                            </td>
                        </tr>
                    }
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="upsertModal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true"
     data-bs-backdrop="static" data-bs-keyboard="false"
     data-title-add="@SharedLocalizer["32"]" data-title-edit="@SharedLocalizer["5583"]">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content term-modal">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-3">
                    <span class="modal-icon" id="modalIcon">+</span>
                    <h5 class="modal-title mb-0" id="modalTitle"></h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="termForm" class="needs-validation" novalidate onsubmit="saveTerm(event)">
                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="formMode" value="true" />  
<input type="hidden" id="culture" value="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" />
                    <div id="formAlert" class="alert alert-danger d-none py-2" role="alert"></div>

                    
                    <div class="form-floating mb-3">

                        <input type="number" id="formCode" class="form-control" placeholder=" " required min="1" max="2147483647">
                        <label for="formCode">@SharedLocalizer["3"]</label>
                    </div>
                   
                    <div class="form-floating mb-3">
                        <input type="text" id="formSName" class="form-control" placeholder=" " required maxlength="50">
                        <label for="formSName">@SharedLocalizer["4"]</label>
                        <div class="invalid-feedback">Required</div>
                    </div>

                    <div class="form-floating mb-3">
                        <input type="text" id="formBName" class="form-control" placeholder=" " required maxlength="150">
                        <label for="formBName">@SharedLocalizer["5"]</label>
                        <div class="invalid-feedback">Required</div>
                    </div>

                    <div class="form-floating mb-3">
                        <input type="number" id="formDays" class="form-control" placeholder=" " min="0" max="32767">
                        <label for="formDays">@SharedLocalizer["6"]</label>
                    </div>

                    <div class="active-box d-flex justify-content-between align-items-center">
                        <label class="form-check-label mb-0" for="formActive">@SharedLocalizer["7"]</label>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" role="switch" id="formActive" checked>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">@SharedLocalizer["11"]</button>
                    <button type="submit" class="btn btn-success px-4" id="btnSave">
                        <span class="spinner-border spinner-border-sm d-none me-1" id="saveSpinner"></span>
                        @SharedLocalizer["10"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


   
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                @SharedLocalizer["38"]
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/SALES/DELIVERYTERMS.js" asp-append-version="true"></script>
}